name: LiteLLM Stable Monitor

on:
  schedule:
    - cron: '0 */12 * * *'
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  check-and-pr:
    runs-on: ubuntu-latest
    steps:

      # Step 1: Get latest stable tag
      - name: Get latest stable tag
        id: check
        run: |
          LATEST=$(curl -s https://api.github.com/repos/BerriAI/litellm/releases \
            | jq -r '[.[] | select(.draft==false and .prerelease==false) | select(.tag_name | test("rc|dev|beta|alpha") | not)] | first | .tag_name')
          echo "Latest stable tag: $LATEST"
          echo "tag=$LATEST" >> $GITHUB_OUTPUT

      # Step 2: Check if PR already exists
      - name: Check existing PR
        id: existing
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          TAG=${{ steps.check.outputs.tag }}
          COUNT=$(gh pr list \
            --repo Lamatic/litellm-proxy \
            --state open \
            --search "sync: BerriAI main ($TAG)" \
            --json title --jq 'length')
          echo "existing=$COUNT" >> $GITHUB_OUTPUT

      # Step 3: Create PR if none exists
      - name: Create PR
        if: steps.existing.outputs.existing == '0'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          TAG=${{ steps.check.outputs.tag }}
          gh pr create \
            --repo Lamatic/litellm-proxy \
            --base lamatic-main \
            --head "BerriAI:litellm:main" \
            --title "sync: BerriAI main ($TAG)" \
            --body "## LiteLLM Upstream Sync
            
          **Version:** $TAG
          **Release notes:** https://github.com/BerriAI/litellm/releases/tag/$TAG
          
          Auto-generated by stable monitor. Review and merge manually."
